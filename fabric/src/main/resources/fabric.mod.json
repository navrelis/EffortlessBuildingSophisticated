{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "sophisticated.building.fabric.SophisticatedBuildingFabric"
    ],
    "client": [
      "sophisticated.building.fabric.SophisticatedBuildingFabricClient"
    ]
  },
  "mixins": [
    "sophisticatedbuilding.mixins.json",
    "sophisticatedbuilding.fabric.mixins.json"
  ],
  "accessWidener": "sophisticatedbuilding.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version_min}",
    "minecraft": "${minecraft_dependency}",
    "fabric": ">=${fabric_api_version_min}",
    "java": ">=${java_version}"
  },
  "suggests": {
    "sophisticatedbackpacks": "*",
    "sophisticatedcore": "*",
    "trinkets": "*"
  }
}
