{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "sophisticated.building.fabric.SophisticatedBuildingFabric"
    ],
    "client": [
      "sophisticated.building.fabric.SophisticatedBuildingFabricClient"
    ]
  },
  "mixins": [
    "sophisticatedbuilding.mixins.json",
    "sophisticatedbuilding.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version_min}",
    "minecraft": "${minecraft_version}",
    "fabric-api": ">=${fabric_api_version_min}",
    "java": ">=21"
  }
}
