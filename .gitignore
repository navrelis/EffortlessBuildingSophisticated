# Version branch worktrees - each versions/<mc>/ is its own git checkout of a mc/<version> branch
# (see scripts/setup-worktrees.ps1). Never tracked from main; each branch tracks its own content.
versions/

# Local-only scratch space: moved-aside dev instances, reference copies, and anything else worth
# keeping on disk without tracking it (see README.md "Local cleanup").
local/

# Build artifacts and binaries
*.jar
*.log

# OS files
.DS_Store
Thumbs.db

# graphify-out/: the report and graph data are tracked (see docs and README); only the local
# Python/runtime pointers and the on-disk cache are not.
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/cache/
